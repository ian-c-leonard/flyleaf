#block(breakable: false, below: 1.36em)[
Thomas Treloar died at Mineral Point in 1966, and Mary in 1971.#src("thomas-death-list")#src("mary-treloar-death") Robert died in Madison on 4 November 2004, and Joan in 2019.#src("robert-death-2004")#src("joan-death-2019")
]
