{
  "name": "flyleaf-website",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run preview",
    "lint": "oxlint app tests vite.config.ts preview.config.ts",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/helpers/settings.mjs --test tests/*.test.ts tests/dismissal-manager.test.mjs",
    "prepare:data": "node scripts/prepare.mjs",
    "predev": "npm run prepare:data",
    "prebuild": "npm run prepare:data",
    "preview": "vite preview --config preview.config.ts",
    "prepare:hosting": "node --experimental-strip-types --import ./flyleaf-globals.mjs scripts/prepare-hosting.mjs",
    "worker:types": "wrangler types worker/env.d.ts --include-runtime false --strict-vars false",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:check": "npm run prepare:hosting && wrangler deploy --dry-run --outdir work/worker-bundle",
    "test:gateway": "node --experimental-strip-types --test tests/gateway.test.mjs",
    "test:worker": "node --test tests/worker-runtime.test.mjs",
    "test:submissions": "node --test tests/submissions-runtime.test.mjs",
    "worker:lint": "oxlint worker public/login/*.js",
    "test:hosting": "node --experimental-strip-types --import ./flyleaf-globals.mjs --test tests/hosting-package.test.mjs",
    "archive": "node scripts/archive.mjs",
    "test:archive": "node --test tests/archive-sync.test.mjs",
    "archive:lint": "oxlint scripts/archive.mjs scripts/archive-sync.mjs scripts/r2-client.mjs tests/archive-sync.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.17.2",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "marked": "18.0.13",
    "motion": "^13.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "miniflare": "5.20260911.0-alpha",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "oxfmt": {
      "tinypool": "2.1.2"
    },
    "source-map-js": "1.2.2"
  }
}
